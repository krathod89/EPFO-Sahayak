// EPFO Sahayak — database schema
// See Engineering/ADR/0002-stateless-mvp-no-auth.md for why this is the only table:
// no User model, no auth. `sessionId` is an opaque client-generated UUID, not an identity.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

/// One row per analytics event. Never store citizen-entered fields here
/// (UAN, claim ID, filing date) — see analytics.md's "Not tracked, on purpose" section.
model AnalyticsEvent {
  id        String   @id @default(uuid())
  sessionId String
  eventType String
  /// Free-form per-event properties — see Engineering/analytics.md for the shape per event type.
  properties Json?
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([eventType])
  @@index([createdAt])
}
