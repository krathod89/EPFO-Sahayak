# Copy to .env and fill in real values. Never commit .env.

# Mixpanel project token (Project Settings -> Access Keys -> "Project Token").
# Safe to expose client-side (it's a write-only identifier, not a secret) — the same
# value is used by both the server-side tracking in lib/analytics.ts and, when the
# frontend is built, Mixpanel's client SDK.
MIXPANEL_TOKEN="your-mixpanel-project-token"

# NEXT_PUBLIC_ prefix makes this reachable from client-side code once the UI wires up
# Mixpanel's browser SDK directly (see Engineering/ADR/0004-analytics-via-mixpanel.md).
NEXT_PUBLIC_MIXPANEL_TOKEN="your-mixpanel-project-token"

# Not used by the MVP (see ADR 0004) — kept here only because a Supabase project already
# exists, reserved for the v2 reference-code case-retrieval feature (PRD.md Section 7a).
# Uncomment and fill in if/when that feature gets built.
# DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true"
# DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres"
